<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>ja</string>
	<key>CFBundleDisplayName</key>
	<string>PadBridge Host</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>iPad のマイクの音が、Mac の Typeless に渡す一時的なマイク「PadBridge iPad マイク」に届いているかを確かめるために使います。</string>
	<key>NSAudioCaptureUsageDescription</key>
	<string>iPad のマイクの音を、Mac の Typeless が使える一時的なマイク「PadBridge iPad マイク」として渡すためと、Mac で鳴っている音を iPad で鳴らすために使います。</string>
	<key>LSMinimumSystemVersion</key>
	<string>$(MACOSX_DEPLOYMENT_TARGET)</string>
	<key>LSUIElement</key>
	<true/>
	<key>NSBonjourServices</key>
	<array>
		<string>_padbridge._tcp</string>
	</array>
	<key>NSLocalNetworkUsageDescription</key>
	<string>同じネットワークにある iPad からの接続を受け付けるために使います。</string>
</dict>
</plist>
